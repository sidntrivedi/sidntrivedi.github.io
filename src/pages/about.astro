---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Siddhant N Trivedi",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I'm Siddhant N Trivedi, a software developer and open-source contributor.
		</p>
		<p>
			This site collects my writing on programming, open source communities, and project work,
			including posts from DGPLUG and Google Summer of Code.
		</p>
		<p>
			You can find my work on <a
				class="cactus-link inline-block"
				href="https://github.com/sidntrivedi012"
				rel="noreferrer"
				target="_blank">GitHub</a
			> or connect with me on <a
				class="cactus-link inline-block"
				href="https://linkedin.com/in/siddhantntrivedi"
				rel="noreferrer"
				target="_blank">LinkedIn</a
			>.
		</p>
	</div>
</PageLayout>
